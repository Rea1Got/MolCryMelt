###############################################################################
# Crystal | liquid along OZ:
#   1) crystal: NPT (aniso)                 -> equilibrium crystal cell
#   2) liquid = molten equilibrium crystal:
#        a) heating to T_melt (NPT), check melting by MSD
#        b) cooling to T_liq (NPT)
#        c) fitting cross-section (lx, ly, xy) to equilibrium crystal (fix deform)
#        d) NPT only along z at T_liq   -> equilibrium liquid cell
#   3) joining (join_phases.py, gap at interfaces) -> short minimize -> common NPT
#   Launch: via run.sh (passes -var dir / T_run / P / cryst_file / n_mol_cryst).
#   Manually: lmp -in two_phase.in -var dir <dir> -var cryst_file <file> \
#                -var n_mol_cryst <N> -var T_run <T> -var P <P>
#   (-in is mandatory: jump SELF is used). ~250+ atoms per process.
###############################################################################

# ============================ PARAMETERS (edit here) =========================
variable dir          index .                 # output directory (-var dir ...)
variable cryst_file   index ${dir}/crystal.data   # -var cryst_file ... (run.sh finds it)
variable n_mol_cryst  index 0                 # -var n_mol_cryst ...   (run.sh takes it from file name)
variable join_script  string join_phases.py
if "${n_mol_cryst} == 0" then "error all 'Need -var cryst_file <file> -var n_mol_cryst <N> (passed by run.sh)'"

variable T_run        index 500.0    # K, temperature (-var T_run ...)
variable P            index 1.0      # atm (units real); -var P ...
variable out          string ${dir}/n${n_mol_cryst}_T${T_run}_P${P}   # prefix of all output files
variable T_cryst      equal ${T_run} # K, crystal equilibration
variable T_liq        equal ${T_run} # K, liquid equilibration

# --- crystal melting to obtain liquid ---
variable melt_factor  equal 1.7      # T_melt = melt_factor * T_liq (significant superheat needed)
variable T_melt       equal 700      # K
variable melt_baro    string aniso   # barostat during melting: aniso or z (z: cross-section as in crystal)
variable msd_melted   equal 20.0     # A^2: MSD of atoms (no COM drift) after melting; less -> stop

variable join_gap     equal 1.0      # A: gap on EACH interface during joining (0 = no gap)

variable dt           equal 1.0      # fs
variable n_nvt        equal 10000    # NVT steps before crystal NPT
variable n_eq_cryst   equal 100000   # crystal NPT steps
variable n_melt       equal 100000   # NPT steps at T_melt
variable n_cool       equal 100000   # cooling steps T_melt -> T_liq
variable n_fit        equal 100000   # steps of liquid cross-section fitting to crystal (NVT + deform)
variable n_eq_liq     equal 100000   # liquid NPT steps (z only)
variable n_zonly      equal 100000   # steps of common NPT z only (close gaps at joint)
variable n_prod       equal 2000000  # common NPT steps (aniso)
variable Tdamp        equal 100.0    # fs
variable Pdamp        equal 5000.0   # fs (softer barostat -> less box fluctuation)
variable comm_cut     equal 4.0      # A; 0 = default (cutoff+skin ~11 A), >0 = expand ghost exchange
variable shake_print  equal 0        # 0 = no SHAKE stats; N = every N steps
variable seed         equal 48291
# =============================================================================
# intermediate result files
variable cryst_eq     string ${out}_crystal_eq.data
variable liq_eq       string ${out}_liquid_eq.data
variable joined       string ${out}_joined_start.data
variable cryst_box    string ${out}_crystal_box.in    # cross-section of equilibrium crystal (transfer between stages)

variable stage index crystal liquid joined    # -var stage liquid joined  -> skip crystal recomputation
label stage_loop

units real
atom_style full
dimension 3
boundary p p p

bond_style harmonic
angle_style harmonic
dihedral_style fourier
improper_style cvff
special_bonds lj 0.0 0.0 0.5 coul 0.0 0.0 0.8333333333
pair_style lj/cut/coul/long 9.0 9.0
pair_modify mix arithmetic tail yes
neigh_modify delay 0 every 1 check yes

if "${stage} == liquid" then "jump SELF liquid_stage"
if "${stage} == joined" then "jump SELF joined_stage"

###############################################################################
# STAGE 1: crystal
###############################################################################
read_data ${cryst_file}
if "${comm_cut} > 0" then "comm_modify mode single cutoff ${comm_cut} vel yes" else "comm_modify mode single vel yes"
kspace_style pppm 1e-4
thermo_style custom step temp press pe vol lx ly lz density
thermo 1000
thermo_modify flush yes

min_style cg
minimize 1.0e-4 1.0e-6 2000 20000
reset_timestep 0

timestep ${dt}
fix shk all shake 0.0001 20 ${shake_print} m 1.008           # SHAKE strictly BEFORE npt
velocity all create ${T_cryst} ${seed} dist gaussian mom yes rot yes
fix nvt_c all nvt temp ${T_cryst} ${T_cryst} ${Tdamp}
run ${n_nvt}
unfix nvt_c
fix npt_c all npt temp ${T_cryst} ${T_cryst} ${Tdamp} aniso ${P} ${P} ${Pdamp}
run ${n_eq_cryst}

# cross-section of equilibrium crystal: liquid fits to it (write to include file)
variable lx_c equal $(lx)
variable ly_c equal $(ly)
variable xy_c equal $(xy)
write_data ${cryst_eq}
print "variable lx_c equal ${lx_c}" file   ${cryst_box} screen no
print "variable ly_c equal ${ly_c}" append ${cryst_box} screen no
print "variable xy_c equal ${xy_c}" append ${cryst_box} screen no

clear
next stage
jump SELF stage_loop
quit          # reached only if stage list (-var stage ...) is exhausted

###############################################################################
# STAGE 2: liquid = molten equilibrium crystal
###############################################################################
label liquid_stage
read_data ${cryst_eq}
include ${cryst_box}                  # variable lx_c / ly_c / xy_c of equilibrium crystal

if "${comm_cut} > 0" then "comm_modify mode single cutoff ${comm_cut} vel yes" else "comm_modify mode single vel yes"
kspace_style pppm 1e-4
thermo_style custom step temp press pe vol lx ly lz density
thermo 1000
thermo_modify flush yes

timestep ${dt}
fix shk all shake 0.0001 20 ${shake_print} m 1.008           # SHAKE strictly BEFORE npt/deform
velocity all create ${T_melt} ${seed} dist gaussian mom yes rot yes

# --- a) melting: NPT at T_melt; MSD of atoms (no COM drift) from stage start ---
compute msd all msd com yes
thermo_style custom step temp press pe vol lx ly lz density c_msd[4]
fix npt_m all npt temp ${T_melt} ${T_melt} ${Tdamp} ${melt_baro} ${P} ${P} ${Pdamp}
run ${n_melt}
if "$(c_msd[4]) < ${msd_melted}" then "error all 'Crystal did not melt (MSD too small): increase melt_factor/T_melt or n_melt'"
unfix npt_m

# --- b) cooling T_melt -> T_liq ---
fix npt_m all npt temp ${T_melt} ${T_liq} ${Tdamp} ${melt_baro} ${P} ${P} ${Pdamp}
run ${n_cool}
unfix npt_m

# --- c) fitting cross-section (x, y, xy) to equilibrium crystal: smooth deformation in NVT ---
fix nvt_l all nvt temp ${T_liq} ${T_liq} ${Tdamp}
fix def_l all deform 100 x final $(xlo) $(xlo+v_lx_c) y final $(ylo) $(ylo+v_ly_c) xy final ${xy_c} remap x
run ${n_fit}
unfix def_l
unfix nvt_l

# --- d) NPT only along z (soft barostat): cross-section stays as in crystal ---
fix npt_l all npt temp ${T_liq} ${T_liq} ${Tdamp} z ${P} ${P} ${Pdamp}
run ${n_eq_liq}

write_data ${liq_eq}
clear
next stage
jump SELF stage_loop
quit          # reached only if stage list (-var stage ...) is exhausted

###############################################################################
# STAGE 3: joining (with gap), short minimize, common NPT
#   Velocities of both phases transferred from equilibrium files (both at T_run), so
#   re-heating/thermostatting not needed; SHAKE enabled before first step.
###############################################################################
label joined_stage
shell python3 ${join_script} ${cryst_eq} ${liq_eq} ${joined} ${join_gap}

read_data ${joined}
group cryst molecule <= ${n_mol_cryst}
group liq subtract all cryst
if "${comm_cut} > 0" then "comm_modify mode single cutoff ${comm_cut} vel yes" else "comm_modify mode single vel yes"
kspace_style pppm 1e-4

variable lz_start equal $(lz)
variable lz_limit equal 2.0*${lz_start}
variable lz_curr  equal lz
fix halt_melt all halt 1000 v_lz_curr > ${lz_limit} error soft message yes

# check: molecules intact (max bond length ~1.5 A)
compute bl all bond/local dist
compute blmax all reduce max c_bl inputs local
thermo_style custom step c_blmax pe
run 0
if "$(c_blmax) > 3.0" then "error all 'Broken molecules detected (bond length > 3 A)'"
uncompute blmax
uncompute bl

compute Tcr cryst temp
compute Tli liq temp
thermo_style custom step temp c_Tcr c_Tli press pe etotal vol lx ly lz density
thermo 1000
thermo_modify flush yes

# remove residual contacts at interfaces (with gap there are few) - short minimize without SHAKE
min_style cg
minimize 1.0e-4 1.0e-6 500 5000
reset_timestep 0

# SHAKE BEFORE barostats; velocities already present (from equilibrium files)
timestep ${dt}
fix shk all shake 0.0001 20 ${shake_print} m 1.008

# density and temperature profiles along z (interface position)
compute zb all chunk/atom bin/1d z lower 0.02 units reduced
fix prof all ave/chunk 10 100 10000 zb density/mass temp file ${out}_zprofile.dat

dump traj all custom 1000 ${out}.lammpstrj id mol type x y z ix iy iz
dump_modify traj sort id pbc yes

# first NPT only along z: gaps at interfaces collapse, cross-section stays crystalline
fix npt_z all npt temp ${T_run} ${T_run} ${Tdamp} z ${P} ${P} ${Pdamp}
thermo 1000
run ${n_zonly}
unfix npt_z

fix npt_all all npt temp ${T_run} ${T_run} ${Tdamp} aniso ${P} ${P} ${Pdamp}
thermo 1000
run ${n_prod}

if "$(lz) > ${lz_limit}" then "print 'already melted'"

write_data ${out}_final.data
write_restart ${out}.restart
