###############################################################################
# Кристалл | жидкость вдоль OZ:
#   1) кристалл отдельно: NPT (aniso)       -> запись равновесной ячейки
#   2) жидкость отдельно: сечение = сечению равновесного кристалла,
#      NPT только вдоль z                   -> запись равновесной ячейки
#   3) склейка (join_phases.py) -> minimize -> общий NPT (aniso)
#   запуск:  mpirun -np 4 lmp -in two_phase.in   (-in: используется jump SELF)
#   ВАЖНО: ~250+ атомов на процесс (кристалл/жидкость ~2000 атомов -> 8 процессов).
#   Серия температур: отдельный mpirun на каждую T (см. run.sh), -var T_run <K>.
###############################################################################

# ============================ ПАРАМЕТРЫ (менять здесь) =======================
# Каталог для всех выходных файлов. Из командной строки:  lmp -in two_phase.in -var dir results/run1
# (каталог должен существовать: mkdir -p results/run1). Без -var используется значение ниже.
variable dir          index .
variable cryst_file   string ${dir}/131762_n256.data
variable liq_file     string ${dir}/131762_n256_liquid.data
variable n_mol_cryst  equal 256      # число молекул кристалла (печатает cif_to_lammps.py)
variable join_script  string join_phases.py

# Значение по умолчанию; из командной строки:  -var T_run 400  (run.sh запускает по mpirun на температуру)
variable T_run        index 360.0    # K, температура общего прогона
variable out          string ${dir}/131762_n256_two_phase_T${T_run}
variable T_cryst      equal ${T_run} # K, уравновешивание кристалла
variable T_liq        equal ${T_run} # K, уравновешивание жидкости
variable P            equal 1.0      # атм (units real)

variable dt           equal 1.0      # fs
variable n_nvt        equal 10000    # шагов NVT перед каждым NPT (термализация, снимает начальный скачок P)
variable n_squeeze    equal 100000   # шагов (0.5 fs) плавного сжатия жидкости по z
variable n_eq_cryst   equal 100000   # шагов NPT кристалла
variable n_eq_liq     equal 100000   # шагов NPT жидкости (только z)
variable n_zonly      equal 50000    # шагов общего NPT только по z (закрыть зазоры на стыке)
variable n_prod       equal 1000000  # шагов общего NPT (aniso)
variable Tdamp        equal 100.0    # fs
variable Pdamp        equal 5000.0   # fs (мягче баростат -> меньше раскачка коробки)
variable comm_cut     equal 0.0      # Å; 0 = по умолчанию (cutoff+skin ~11 Å), >0 = расширить обмен призраками
variable shake_print  equal 0        # 0 = не печатать статистику SHAKE; N = каждые N шагов
variable seed         equal 48291
# =============================================================================
# файлы промежуточных результатов
variable cryst_eq     string ${out}_crystal_eq.data
variable liq_eq       string ${out}_liquid_eq.data
variable joined       string ${out}_joined_start.data

# Перезапуск без кристалла: замените строку ниже на  "variable stage index liquid joined"
# и задайте сечение равновесного кристалла (xy возьмите из заголовка *_crystal_eq.data):
#   variable lx_c equal 22.874313
#   variable ly_c equal 21.436633
#   variable xy_c equal 0.0
#   variable lz_c equal 37.56     (Lz из заголовка *_crystal_eq.data: zhi - zlo)
variable stage index crystal liquid joined
label stage_loop

units real
atom_style full
dimension 3
boundary p p p

bond_style harmonic
angle_style harmonic
dihedral_style fourier
improper_style cvff
special_bonds lj 0.0 0.0 0.5 coul 0.0 0.0 0.8333333333
pair_style lj/cut/coul/long 9.0 9.0
pair_modify mix arithmetic tail yes
neigh_modify delay 0 every 1 check yes

if "${stage} == liquid" then "jump SELF liquid_stage"
if "${stage} == joined" then "jump SELF joined_stage"

###############################################################################
# СТАДИЯ 1: кристалл
###############################################################################
read_data ${cryst_file}
if "${comm_cut} > 0" then "comm_modify mode single cutoff ${comm_cut} vel yes" else "comm_modify mode single vel yes"
kspace_style pppm 1e-4
thermo_style custom step temp press pe vol lx ly lz density
thermo 1000
thermo_modify flush yes

min_style cg
minimize 1.0e-4 1.0e-6 2000 20000
reset_timestep 0

timestep ${dt}
fix shk all shake 0.0001 20 ${shake_print} m 1.008           # SHAKE строго ДО npt
velocity all create ${T_cryst} ${seed} dist gaussian mom yes rot yes
fix nvt_c all nvt temp ${T_cryst} ${T_cryst} ${Tdamp}
run ${n_nvt}
unfix nvt_c
fix npt_c all npt temp ${T_cryst} ${T_cryst} ${Tdamp} aniso ${P} ${P} ${Pdamp}
run ${n_eq_cryst}

# сечение равновесного кристалла: к нему подгоняется жидкость
variable lx_c equal $(lx)
variable ly_c equal $(ly)
variable xy_c equal $(xy)
variable lz_c equal $(lz)
write_data ${cryst_eq}
clear
next stage
jump SELF stage_loop
quit          # сюда попадаем, только если список стадий (-var stage ...) исчерпан

###############################################################################
# СТАДИЯ 2: жидкость (x, y зафиксированы по кристаллу, расширение только вдоль z)
###############################################################################
label liquid_stage
read_data ${liq_file}
change_box all x final $(xlo) $(xlo+v_lx_c) y final $(ylo) $(ylo+v_ly_c) xy final ${xy_c} remap units box
if "${comm_cut} > 0" then "comm_modify mode single cutoff ${comm_cut} vel yes" else "comm_modify mode single vel yes"
kspace_style pppm 1e-4
thermo_style custom step temp press pe vol lx ly lz density
thermo 1000
thermo_modify flush yes

# убираем перекрытия случайной упаковки: minimize, затем мягкий нагрев 20 K -> T_liq
# (nve/limit ограничивает смещение за шаг, berendsen отводит избыточную энергию)
min_style cg
minimize 1.0e-4 1.0e-6 2000 20000
velocity all create 20.0 ${seed} dist gaussian mom yes rot yes
timestep 0.25
fix relax all nve/limit 0.05
fix ramp all temp/berendsen 20.0 ${T_liq} 50.0
run 20000
unfix ramp
unfix relax
reset_timestep 0

timestep 0.5
fix shk all shake 0.0001 20 ${shake_print} m 1.008          # SHAKE строго ДО deform/npt
velocity all create ${T_liq} ${seed} dist gaussian mom yes rot yes

# --- Этап 1: плавное сжатие по z (NVT + deform) до ~90% плотности кристалла ---
# жидкость стартует растянутой (factor>1); барростат не должен делать этот скачок
variable lz_t equal 1.15*${lz_c}
fix nvt_l all nvt temp ${T_liq} ${T_liq} ${Tdamp}
fix def_l all deform 100 z final $(zlo) $(zlo+v_lz_t) remap x
run ${n_squeeze}
unfix def_l
unfix nvt_l

# --- Этап 2: короткий NVT, затем NPT только вдоль z (мягкий баростат) ---
fix nvt_l all nvt temp ${T_liq} ${T_liq} ${Tdamp}
run ${n_nvt}
unfix nvt_l
timestep ${dt}
fix npt_l all npt temp ${T_liq} ${T_liq} ${Tdamp} z ${P} ${P} ${Pdamp}
run ${n_eq_liq}

write_data ${liq_eq}
clear
next stage
jump SELF stage_loop
quit          # сюда попадаем, только если список стадий (-var stage ...) исчерпан

###############################################################################
# СТАДИЯ 3: склейка, minimize (убрать коллизии на стыке), общий NPT
###############################################################################
label joined_stage
shell python3 ${join_script} ${cryst_eq} ${liq_eq} ${joined}

read_data ${joined}
group cryst molecule <= ${n_mol_cryst}
group liq subtract all cryst
if "${comm_cut} > 0" then "comm_modify mode single cutoff ${comm_cut} vel yes" else "comm_modify mode single vel yes"
kspace_style pppm 1e-4

# проверка: молекулы целые (макс. длина связи ~1.5 Å)
compute bl all bond/local dist
compute blmax all reduce max c_bl inputs local
thermo_style custom step c_blmax pe
run 0
if "$(c_blmax) > 3.0" then "error all 'Есть разорванные молекулы (длина связи > 3 A)'"
uncompute blmax
uncompute bl

compute Tcr cryst temp
compute Tli liq temp
thermo_style custom step temp c_Tcr c_Tli press pe etotal vol lx ly lz density
thermo 1000
thermo_modify flush yes

# убираем коллизии на границе раздела (без SHAKE)
min_style cg
minimize 1.0e-4 1.0e-6 2000 20000
velocity all create 100.0 ${seed} dist gaussian mom yes rot yes
timestep 0.25
fix relax all nve/limit 0.05
fix ramp all temp/berendsen 100.0 ${T_run} 50.0
thermo 500
run 20000
unfix ramp
unfix relax
reset_timestep 0

# общий NPT
timestep ${dt}
fix shk all shake 0.0001 20 ${shake_print} m 1.008
velocity all create ${T_run} ${seed} dist gaussian mom yes rot yes
fix nvt_j all nvt temp ${T_run} ${T_run} ${Tdamp}
run ${n_nvt}
unfix nvt_j
# профили плотности и температуры вдоль z (положение границы раздела)
compute zb all chunk/atom bin/1d z lower 0.02 units reduced
fix prof all ave/chunk 10 100 10000 zb density/mass temp file ${out}_zprofile.dat

dump traj all custom 1000 ${out}.lammpstrj id mol type x y z ix iy iz
dump_modify traj sort id pbc yes

fix npt_z all npt temp ${T_run} ${T_run} ${Tdamp} z ${P} ${P} ${Pdamp}
thermo 1000
run ${n_zonly}
unfix npt_z
fix npt_all all npt temp ${T_run} ${T_run} ${Tdamp} aniso ${P} ${P} ${Pdamp}

thermo 1000
run ${n_prod}

write_data ${out}_final.data
write_restart ${out}.restart
